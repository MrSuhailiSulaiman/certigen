# URL projek Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://dhgevqfinjoyxlfotkec.supabase.co
# SUPABASE_URL=

# Kunci anon / publishable. Boleh dipakai oleh pelayan aplikasi ini.
# Jangan commit nilai sebenar. Salin dari Supabase → Project Settings → API.
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci rahsia pelayan, jika ada. Ia memintas RLS. Jangan dedahkan pada pelayar.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Rahsia tandatangan kuki sesi. Jika kosong, kunci service role digunakan.
AUTH_SECRET=
