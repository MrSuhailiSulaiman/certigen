# URL projek Supabase.
# Integrasi Vercel Marketplace biasanya mengisi NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=

# Kunci rahsia pelayan. Jangan letak dalam pembolehubah NEXT_PUBLIC_.
# Guna salah satu nama yang disediakan oleh Supabase atau Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# PIN panel penganjur. Minimum 4 aksara. Wajib dalam production.
ORGANIZER_PIN=
